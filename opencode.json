{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*firebase-adminsdk*.json": "deny",
      "~/.ssh/**": "deny",
      "~/.bashrc": "deny"
    },
    "edit": {
      "*": "allow",
      "opencode.json": "deny",
      ".claude/**": "deny"
    },
    "grep": "allow",
    "glob": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "npm run check*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "*cat *.env*": "deny",
      "*grep *CANARIO*": "deny",
      "*curl *": "deny",
      "*wget *": "deny",
      "*sudo *": "deny",
      "*rm -rf*": "deny",
      "*git push --force*": "deny",
      "*git reset --hard*": "deny"
    }
  }
}